--synthesis_resources = lut 8 
SUBDESIGN decode_egb32
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[7..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[7..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode10408w[3..0]	: WIRE;
	w_anode10425w[3..0]	: WIRE;
	w_anode10435w[3..0]	: WIRE;
	w_anode10445w[3..0]	: WIRE;
	w_anode10455w[3..0]	: WIRE;
	w_anode10465w[3..0]	: WIRE;
	w_anode10475w[3..0]	: WIRE;
	w_anode10485w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[7..0] = eq_wire[7..0];
	eq_wire[] = ( w_anode10485w[3..3], w_anode10475w[3..3], w_anode10465w[3..3], w_anode10455w[3..3], w_anode10445w[3..3], w_anode10435w[3..3], w_anode10425w[3..3], w_anode10408w[3..3]);
	w_anode10408w[] = ( (w_anode10408w[2..2] & (! data_wire[2..2])), (w_anode10408w[1..1] & (! data_wire[1..1])), (w_anode10408w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode10425w[] = ( (w_anode10425w[2..2] & (! data_wire[2..2])), (w_anode10425w[1..1] & (! data_wire[1..1])), (w_anode10425w[0..0] & data_wire[0..0]), enable_wire);
	w_anode10435w[] = ( (w_anode10435w[2..2] & (! data_wire[2..2])), (w_anode10435w[1..1] & data_wire[1..1]), (w_anode10435w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode10445w[] = ( (w_anode10445w[2..2] & (! data_wire[2..2])), (w_anode10445w[1..1] & data_wire[1..1]), (w_anode10445w[0..0] & data_wire[0..0]), enable_wire);
	w_anode10455w[] = ( (w_anode10455w[2..2] & data_wire[2..2]), (w_anode10455w[1..1] & (! data_wire[1..1])), (w_anode10455w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode10465w[] = ( (w_anode10465w[2..2] & data_wire[2..2]), (w_anode10465w[1..1] & (! data_wire[1..1])), (w_anode10465w[0..0] & data_wire[0..0]), enable_wire);
	w_anode10475w[] = ( (w_anode10475w[2..2] & data_wire[2..2]), (w_anode10475w[1..1] & data_wire[1..1]), (w_anode10475w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode10485w[] = ( (w_anode10485w[2..2] & data_wire[2..2]), (w_anode10485w[1..1] & data_wire[1..1]), (w_anode10485w[0..0] & data_wire[0..0]), enable_wire);
END;
